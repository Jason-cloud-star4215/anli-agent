[
  {
    "provision_id": "mfd-1179",
    "law_name": "中华人民共和国民法典",
    "article": "第一千一百七十九条",
    "text": "第一千一百七十九条侵害他人造成人身损害的，应当赔偿医疗费、护理费、交通费、营养费、住院伙食补助费等为治疗和康复支出的合理费用，以及因误工减少的收入。造成残疾的，还应当赔偿辅助器具费和残疾赔偿金；造成死亡的，还应当赔偿丧葬费和死亡赔偿金。",
    "source_url": "http://www.xinhuanet.com/politics/2020-06/01/c_1126061072_7.htm",
    "effective": "2021-01-01",
    "verified": true,
    "note": "已从权威公开来源抓取并核验",
    "topics": [
      "交通事故",
      "人身损害",
      "赔偿范围",
      "误工费",
      "医疗费",
      "护理费"
    ],
    "domain": "civil"
  },
  {
    "provision_id": "mfd-1173",
    "topics": [
      "责任比例",
      "过错",
      "减轻责任",
