  {
    "provision_id": "mfd-1183",
    "law_name": "中华人民共和国民法典",
    "article": "第一千一百八十三条",
    "text": "第一千一百八十三条侵害自然人人身权益造成严重精神损害的，被侵权人有权请求精神损害赔偿。因故意或者重大过失侵害自然人具有人身意义的特定物造成严重精神损害的，被侵权人有权请求精神损害赔偿。",
    "source_url": "http://www.xinhuanet.com/politics/2020-06/01/c_1126061072_7.htm",
    "effective": "2021-01-01",
    "verified": true,
    "note": "已从权威公开来源抓取并核验",
    "topics": [
      "精神损害赔偿",
      "人身损害",
      "严重精神损害"
    ],
    "domain": "civil"
  },
  {
    "provision_id": "mfd-1184",
    "law_name": "中华人民共和国民法典",
    "article": "第一千一百八十四条",
    "text": "第一千一百八十四条侵害他人财产的，财产损失按照损失发生时的市场价格或者其他合理方式计算。",
    "source_url": "http://www.xinhuanet.com/politics/2020-06/01/c_1126061072_7.htm",
    "effective": "2021-01-01",
