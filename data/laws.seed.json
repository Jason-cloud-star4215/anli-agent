  {
    "provision_id": "xbf-55",
    "topics": [
      "消费维权",
      "欺诈",
      "退一赔三",
      "惩罚性赔偿"
    ],
    "law_name": "中华人民共和国消费者权益保护法",
    "article": "第五十五条",
    "text": "摘要（非原文）：经营者提供商品或者服务有欺诈行为的，应当按照消费者的要求增加赔偿其受到的损失，增加赔偿的金额为消费者购买商品价款或者接受服务费用的三倍；增加赔偿的金额不足五百元的，为五百元。",
    "source_url": "https://flk.npc.gov.cn/",
    "effective": "2014-03-15",
    "verified": false,
